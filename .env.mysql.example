# Frontend — valores públicos entregues ao navegador
# No ambiente corporativo, VITE_SEGEMPAT_REQUIRE_API=true impede o uso do modo demonstração
# quando a API corporativa é exigida.
VITE_SEGEMPAT_API_URL="https://segempat-api.empresa.local"
VITE_SEGEMPAT_REQUIRE_API="true"

# Servidor — NUNCA prefixar com VITE_
# Preencha somente no servidor/cofre de secrets da empresa. Não versionar valores reais.
SEGEMPAT_DB_DRIVER="mysql"
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_DATABASE="segempat"
MYSQL_USER="segempat_app"
MYSQL_PASSWORD=""
MYSQL_SSL="true"
SEGEMPAT_SESSION_SECRET=""
SEGEMPAT_STORAGE_DRIVER="filesystem"
SEGEMPAT_STORAGE_PATH=""

# Arquitetura vigente:
# Cloudflare/frontend -> API SEGEMPAT Node/Express -> MySQL 8 corporativo.
# Não existe fallback para outro backend. O modo demonstração é local, usa apenas dados fictícios
# e é desabilitado quando VITE_SEGEMPAT_API_URL existe ou VITE_SEGEMPAT_REQUIRE_API=true.
