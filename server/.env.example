# SEGEMPAT API · edição Supabase/PostgreSQL
# Copie para o ambiente do servidor e cadastre os valores reais como secrets.
# NUNCA coloque DATABASE_URL, senha do banco ou service-role key no frontend/VITE_*.

NODE_ENV=production
PORT=8787

# PostgreSQL do projeto Supabase — somente no backend da API.
# DATABASE_URL é a role de runtime, usada continuamente pela aplicação.
DATABASE_URL=postgresql://segempat_runtime:CHANGE_ME@host:5432/database

# Credencial temporária/separada para aplicar migrations.
# O runner exige valor diferente de DATABASE_URL em produção.
# Não reutilize esta URL na API após o processo de migration.
SEGEMPAT_MIGRATION_DATABASE_URL=postgresql://segempat_migrator:CHANGE_ME@host:5432/database

# Em produção, true é obrigatório.
POSTGRES_SSL=true
# Deixe vazio quando a cadeia do certificado já for confiável pelo sistema operacional.
# Se usar CA própria, em produção o caminho precisa ser absoluto.
POSTGRES_SSL_CA_PATH=
POSTGRES_POOL_SIZE=10

# Sessão da API
SEGEMPAT_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_BYTES_MINIMUM
SEGEMPAT_SESSION_COOKIE=segempat_session
SEGEMPAT_SESSION_TTL_HOURS=12
SEGEMPAT_SESSION_SECURE=true
SEGEMPAT_SESSION_SAMESITE=lax

# Origens exatas autorizadas, separadas por vírgula. Não use * com cookies.
SEGEMPAT_ALLOWED_ORIGINS=https://segempat.example.com

# Evidências continuam privadas e mediadas pela API nesta etapa.
# A migração para Supabase Storage será feita separadamente, sem tornar o bucket público.
SEGEMPAT_STORAGE_DRIVER=filesystem
SEGEMPAT_STORAGE_PATH=/var/lib/segempat/storage

SEGEMPAT_TIMEZONE=America/Maceio
