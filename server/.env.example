# SEGEMPAT API · modelo de configuração para homologação/produção
# Copie para o ambiente do servidor e cadastre os valores reais como secrets.
# NUNCA coloque credenciais reais no frontend ou em variáveis VITE_*.

# Valores aceitos: production, development ou test.
NODE_ENV=production
PORT=8787

# MySQL corporativo — credencial de RUNTIME da API.
# Esta conta deve possuir somente os grants necessários à operação normal do SEGEMPAT.
# Ela NÃO deve possuir CREATE/ALTER/DROP/TRIGGER/INDEX/GRANT OPTION em produção.
MYSQL_HOST=mysql.empresa.local
MYSQL_PORT=3306
MYSQL_DATABASE=segempat
MYSQL_USER=segempat_app
MYSQL_PASSWORD=CHANGE_ME
# Aceita somente true ou false. Em produção, true é obrigatório.
MYSQL_SSL=true
# Deixe vazio quando o certificado do MySQL encadear em uma CA já confiada pelo sistema operacional.
# Preencha somente quando a TI exigir CA própria/interna; em produção o caminho deve ser absoluto.
MYSQL_SSL_CA_PATH=
MYSQL_POOL_SIZE=10

# Migrations em produção usam uma SEGUNDA credencial controlada pela TI.
# Não persista a senha de migration neste arquivo de runtime nem no serviço da API.
# Injete MYSQL_MIGRATION_USER e MYSQL_MIGRATION_PASSWORD pelo secrets manager/canal seguro
# somente durante `npm run migrate`. O usuário de migration deve ser diferente de MYSQL_USER.
# MYSQL_MIGRATION_USER=segempat_migrator
# MYSQL_MIGRATION_PASSWORD=<secret somente durante migration>

# Sessão da API
# Obrigatório: segredo aleatório, exclusivo do ambiente e com pelo menos 32 bytes.
SEGEMPAT_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_BYTES_MINIMUM
SEGEMPAT_SESSION_COOKIE=segempat_session
SEGEMPAT_SESSION_TTL_HOURS=12
# Aceita somente true ou false. Em NODE_ENV=production, true é obrigatório.
SEGEMPAT_SESSION_SECURE=true

# Se frontend e API estiverem no mesmo site corporativo (ex.: app.empresa.com e api.empresa.com),
# prefira lax. Se realmente forem cross-site, use none + HTTPS e valide a política do navegador.
SEGEMPAT_SESSION_SAMESITE=lax

# Obrigatório em NODE_ENV=production.
# Origens exatas autorizadas, separadas por vírgula. Não use * com cookies.
# Em produção, todas as origens devem usar HTTPS.
# Ex.: https://segempat.empresa.com,https://homolog-segempat.empresa.com
SEGEMPAT_ALLOWED_ORIGINS=https://segempat.empresa.com

# Storage privado de assinaturas/evidências.
# O único driver implementado atualmente é filesystem.
SEGEMPAT_STORAGE_DRIVER=filesystem
# Em NODE_ENV=production o caminho deve ser absoluto e apontar para volume persistente com backup.
SEGEMPAT_STORAGE_PATH=/var/lib/segempat/storage

# Timezone IANA válida usada pelas regras funcionais do sistema.
SEGEMPAT_TIMEZONE=America/Maceio
