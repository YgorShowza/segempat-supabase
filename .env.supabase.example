# SEGEMPAT · edição Supabase/PostgreSQL
# Este arquivo contém somente variáveis públicas do frontend.
# Credenciais PostgreSQL, DATABASE_URL e segredos de sessão pertencem exclusivamente ao servidor da API.

VITE_SEGEMPAT_API_URL="https://segempat-api.example.com"
VITE_SEGEMPAT_REQUIRE_API="true"

# Arquitetura vigente desta edição:
# Cloudflare/frontend -> API SEGEMPAT Node/Express -> Supabase/PostgreSQL.
# Não coloque DATABASE_URL, senha do banco, service-role key ou SEGEMPAT_SESSION_SECRET em VITE_*.
